# Bind address & port
AGY_GATEWAY_HOST=127.0.0.1
AGY_GATEWAY_PORT=8787

# Public domain & optional public IP served by Caddy (auto HTTPS)
AGY_GATEWAY_DOMAIN=gateway.example.com
# AGY_GATEWAY_PUBLIC_IP=your-server-ip

# Optional admin bearer key to enable /admin/* HTTP endpoints
# Leave empty to manage keys strictly via local `agy-gateway key` CLI
AGY_GATEWAY_ADMIN_KEY=

# Path to official `agy` binary (auto-detected if on PATH or ~/.local/bin/agy)
# AGY_GATEWAY_AGY_BIN=/usr/local/bin/agy

# Isolated empty directory used as cwd for `agy --sandbox`
AGY_GATEWAY_WORKDIR=./data/agy-workdir
AGY_GATEWAY_DB_PATH=./data/gateway.db
# Optional PostgreSQL DSN (when set, replaces local SQLite for keys, accounts & context checkpoints)
# AGY_GATEWAY_DATABASE_URL=postgresql://agy_gateway:password@host:5432/agy_gateway?sslmode=prefer
AGY_GATEWAY_ACCOUNTS_DIR=./data/accounts

# Concurrency, routing & housekeeping
AGY_GATEWAY_MAX_CONCURRENCY=12
AGY_GATEWAY_QUEUE_TIMEOUT_SECONDS=300
AGY_GATEWAY_REQUEST_TIMEOUT_SECONDS=600
AGY_GATEWAY_SSE_KEEPALIVE_SECONDS=10
AGY_GATEWAY_MAX_PROMPT_BYTES=191500
# Long-session context management (deterministic | hybrid | llm)
AGY_GATEWAY_COMPACTION_MODE=deterministic
# Optional dedicated fast model for hybrid/llm compaction (empty = current request model)
# AGY_GATEWAY_COMPACTION_MODEL=gemini-3.8-flash-low
AGY_GATEWAY_COMPACTION_KEEP_RECENT_BYTES=96000
AGY_GATEWAY_COMPACTION_CHECKPOINT_MAX_BYTES=24000
AGY_GATEWAY_COMPACTION_TOOL_OUTPUT_MAX_BYTES=12000
AGY_GATEWAY_COMPACTION_CACHE_TTL_HOURS=24
AGY_GATEWAY_OVERFLOW_MAX_RETRIES=2
# Native `agy --conversation` multi-turn session reuse (unlocks full 1M context window via delta turns)
AGY_GATEWAY_SESSION_REUSE_ENABLED=true
AGY_GATEWAY_SESSION_TTL_HOURS=24
AGY_GATEWAY_MAX_MEDIA_FILES=16
AGY_GATEWAY_MAX_MEDIA_FILE_BYTES=26214400
AGY_GATEWAY_MAX_MEDIA_TOTAL_BYTES=52428800
AGY_GATEWAY_ALLOW_REMOTE_MEDIA_URLS=true
AGY_GATEWAY_ROUTING_STRATEGY=least_busy
AGY_GATEWAY_ACCOUNT_COOLDOWN_SECONDS=90
AGY_GATEWAY_ARTIFACT_RETENTION_MINUTES=30

# Default model & reasoning effort
AGY_GATEWAY_DEFAULT_MODEL=gemini-3.8-flash-high
# AGY_GATEWAY_DEFAULT_EFFORT=medium
AGY_GATEWAY_SANDBOX=true
AGY_GATEWAY_DISABLE_SLASH_COMMANDS=true
